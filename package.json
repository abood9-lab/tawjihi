{
  "name": "groq-api-server",
  "version": "1.0.0",
  "description": "Backend server for GROQ API integration with TawjihiGuide",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "tailwindcss -c tailwind.config.js -i ./input.css -o ./dist/output.css --watch",
    "build": "tailwindcss -c tailwind.config.js -i ./input.css -o ./dist/output.css --minify",
    "dev:server": "node --watch server.js"
  },
  "keywords": [
    "groq",
    "api",
    "ai",
    "chat"
  ],
  "author": "TawjihiGuide Team",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "node-fetch": "^3.3.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/forms": "^0.5.10",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17"
  }
}
